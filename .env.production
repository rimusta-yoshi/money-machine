# Production build of the homepage and builder (served at https://localblocks.co.uk). Nothing here is secret.
VITE_API_URL=https://api.localblocks.co.uk
VITE_SAMPLE_PHOTOS_URL=https://api.localblocks.co.uk/samples
# Off: payments are on, so the public builder never shows the admin key field (publishing
# without paying stays possible from a dev build: npm run dev:api, for testing and support).
VITE_ADMIN_PUBLISH=
# Cloudflare Web Analytics, homepage only: the site token from Web Analytics → localblocks.co.uk → Manage site (public, not a secret).
VITE_CF_BEACON_TOKEN=
