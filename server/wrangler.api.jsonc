// The API worker: api.<base> (the builder's API) and preview.<base> (preview links).
// Deploy: npm run cf:deploy (see server/README.md). Values marked REPLACE come from your Cloudflare account.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "siteblocks-api",
  "main": "cloudflare/api-worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  // More specific than the site worker's *.localblocks.co.uk/*, so these hosts come here.
  "routes": [
    { "pattern": "api.localblocks.co.uk/*", "zone_name": "localblocks.co.uk" },
    { "pattern": "preview.localblocks.co.uk/*", "zone_name": "localblocks.co.uk" }
  ],
  // The product's name (emails, Stripe's page) comes from src/brand/config.ts, like everything else.
  "vars": {
    "BASE_DOMAIN": "localblocks.co.uk",
    // Where the builder runs. Comma-separated origins, no trailing slash.
    "BUILDER_ORIGINS": "https://localblocks.co.uk,https://www.localblocks.co.uk,http://localhost:5173",
    // Staging: noindex on everything until launch.
    "NOINDEX": "true",
    "PREVIEW_DAYS": "30",
    // Where the homepage and builder live: links in emails, Stripe's return pages.
    "APP_URL": "https://localblocks.co.uk",
    // The one price, in pence. The builder never sends an amount.
    "PRICE_PENCE": "9900",
    "REFUND_DAYS": "14",
    // "true" opens orders to everyone. Until then a checkout needs the TESTER_CODE secret.
    "LAUNCHED": "false",
    "EMAIL_FROM": "Local Blocks <hello@localblocks.co.uk>",
    "SUPPORT_EMAIL": "hello@localblocks.co.uk",
    // Own domains (Cloudflare for SaaS): the localblocks.co.uk zone's id (not secret; from the
    // zone's Overview page) switches it on together with the CF_SAAS_TOKEN secret. Empty: off.
    "CF_ZONE_ID": "1e522311bbad8ab68ac0c1cfc708ab42",
    // The CNAME target customers point their www at (server/domainconnect/ names the same).
    "DOMAINS_TARGET": "domains.localblocks.co.uk",
    // One-click connecting (Domain Connect): DNS providers that approved our template, by their
    // Domain Connect id, comma-separated (e.g. "godaddy,ionos"). Empty: everyone gets the guide.
    // Needs the DC_PRIVATE_KEY secret. See docs/domain-connect.md.
    "DC_PROVIDERS": "",
    "DC_KEY_HOST": "_dck1"
    // Secrets (never in this file): see server/README.md "Payments and email" and "Own domains".
    //   ADMIN_TOKEN, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, LINK_SECRET, RESEND_API_KEY, TESTER_CODE,
    //   CF_SAAS_TOKEN, DC_PRIVATE_KEY
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "siteblocks", "database_id": "400a2f77-8ebe-4878-8576-c9747999bc80", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "siteblocks" }],
  // Caps the builder's dashboard events per address (counted in memory at the edge, never stored).
  "ratelimits": [{ "name": "EVENT_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  // Self-hosted fonts, deployed with the code. The worker decides what to serve.
  "assets": { "directory": "../public/fonts", "binding": "ASSETS", "run_worker_first": true },
  // Daily: expired links and holds, unused drafts, dashboard events older than 13 months, ended
  // sites' own domains. Every 15 minutes: own domains waiting to go live.
  "triggers": { "crons": ["17 3 * * *", "*/15 * * * *"] },
  "observability": { "enabled": true }
}
