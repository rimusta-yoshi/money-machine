{
  "name": "money-machine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fonts": "node scripts/copy-fonts.mjs",
    "sheet": "node scripts/contact-sheet.mjs",
    "a11y": "node scripts/a11y-browser.mjs",
    "e2e": "vitest run -c vitest.e2e.config.ts",
    "dev:stack": "node scripts/dev-stack.ts",
    "dev:api": "vite --mode stack",
    "dev:pay": "node scripts/dev-pay.mjs",
    "cf:migrate": "wrangler d1 migrations apply siteblocks --remote -c server/wrangler.api.jsonc",
    "cf:deploy": "wrangler deploy -c server/wrangler.api.jsonc && wrangler deploy -c server/wrangler.site.jsonc",
    "cf:samples": "node scripts/upload-samples.mjs",
    "cf:deploy:app": "npm run build && wrangler deploy -c server/wrangler.app.jsonc"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "miniflare": "^5.20261001.0-alpha",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.1",
    "wrangler": "^4.147.0"
  }
}
