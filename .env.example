# Copy to .env.local and fill in. Nothing here is secret.

# The publishing API (server/README.md). Unset: the builder saves nothing and can't publish.
VITE_API_URL=https://api.siteblocks.co.uk

# Where the builder loads its sample stock photos from in production (served by the API from R2).
# Leave unset to draw placeholder photos instead. The dev server uses reference/sample-photos.
VITE_SAMPLE_PHOTOS_URL=https://api.siteblocks.co.uk/samples

# "true" shows the admin publish form in a production build (dev builds always show it). Phase 1 only.
VITE_ADMIN_PUBLISH=
